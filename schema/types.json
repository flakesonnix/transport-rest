      "open": true,
      "values": [
        "bahncard-1st-25", "bahncard-2nd-25", "bahncard-1st-50", "bahncard-2nd-50",
        "bahncard-1st-100", "bahncard-2nd-100", "vorteilscard", "halbtaxabo",
