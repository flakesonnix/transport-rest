      "values": ["aircraft", "bicycle", "bus", "car", "gondola", "taxi", "train", "walking", "watercraft"]
    },
    "PrognosisType": {
      "doc": "Reliability class of a prognosis.",
      "open": true,
      "values": ["calculated", "prognosed"]
    },
    "WalkingSpeed": { "open": false, "values": ["slow", "normal", "fast"] },
    "Accessibility": { "open": true, "values": ["partial", "complete"] },
