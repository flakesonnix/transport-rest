    "Ids": { "type": "map<string>", "doc": "External identifiers (e.g. dhid, MDV, NASA)." },
    "ServiceDays": { "type": "map<bool>", "doc": "ISO date -> served. db-vendo: serviceDays; hafas-client: scheduledDays." },
