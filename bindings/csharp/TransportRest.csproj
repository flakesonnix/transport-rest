<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>TransportRest</PackageId>
    <Version>0.1.0</Version>
    <Authors>natasha</Authors>
    <Description>Typed client for the transport.rest public transit APIs (DB, BVG, VBB, Poland)</Description>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/natasha/transport-rest</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Client.cs" />
    <Compile Include="Models.Generated.cs" />
  </ItemGroup>
</Project>
